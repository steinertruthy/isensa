    { "source": "smc", "prefix": "Te", "kind": "temperature", "group": "cpu", "name": "CPU · Efficiency cores", "aggregate": "cpu", "generations": [3], "verifiedOn": ["Mac15,6"] },
    { "source": "smc", "prefix": "Tg", "kind": "temperature", "group": "gpu", "name": "GPU", "aggregate": "gpu", "generations": [3], "verifiedOn": ["Mac15,6"] },
    { "source": "smc", "keys": ["TB0T", "TB1T", "TB2T"], "kind": "temperature", "group": "battery", "name": "Battery", "generations": [], "verifiedOn": [] },
    { "source": "hid", "prefix": "gas gauge battery", "kind": "temperature", "group": "battery", "name": "Battery gas gauge", "generations": [], "verifiedOn": [] },
    { "source": "hid", "prefix": "NAND", "kind": "temperature", "group": "storage", "name": "SSD (NAND)", "generations": [], "verifiedOn": ["Mac15,6"] },
    { "source": "hid", "prefix": "PMU tdie", "kind": "temperature", "group": "system", "name": "SoC die (PMU)", "generations": [], "verifiedOn": [] }
  ]
