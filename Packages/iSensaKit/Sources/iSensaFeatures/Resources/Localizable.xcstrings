    "A few things deserve your attention.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns pontos merecem sua atenção."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay algunos puntos que merecen tu atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques points méritent votre attention."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Punkte verdienen deine Aufmerksamkeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni aspetti meritano la tua attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか確認していただきたい点があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 가지 확인이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几项需要你留意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有幾個項目需要你留意。"
          }
        }
      }
    },
    "A light tap when you mark a favorite or confirm an action, on Force Touch trackpads.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque leve ao marcar um favorito ou confirmar uma ação, em trackpads Force Touch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque suave al marcar un favorito o confirmar una acción, en trackpads Force Touch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un léger retour lorsque vous ajoutez un favori ou confirmez une action, sur les trackpads Force Touch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichtes Tippen, wenn du einen Favoriten markierst oder eine Aktion bestätigst – auf Force Touch-Trackpads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco leggero quando segni un preferito o confermi un’azione, sui trackpad Force Touch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加したり操作を確定したりしたときに、感圧トラックパッドで軽い振動を返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기를 표시하거나 동작을 확인할 때 Force Touch 트랙패드에서 가볍게 진동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标记个人收藏或确认操作时，于力度触控触控板上轻触提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在標示喜好項目或確認動作時，於力度觸控式軌跡板上輕觸回饋。"
          }
        }
      }
    },
