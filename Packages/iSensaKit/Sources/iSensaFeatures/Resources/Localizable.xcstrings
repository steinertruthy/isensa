    "Temperature sensors stopped responding. iSensa keeps retrying automatically.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sensores de temperatura pararam de responder. O iSensa continua tentando automaticamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sensores de temperatura han dejado de responder. iSensa sigue reintentándolo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capteurs de température ne répondent plus. iSensa réessaie automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Temperatursensoren reagieren nicht mehr. iSensa versucht es automatisch weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sensori di temperatura hanno smesso di rispondere. iSensa continua a riprovare automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度センサーが応答しなくなりました。iSensaは自動的に再試行を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도 센서가 응답하지 않습니다. iSensa가 자동으로 계속 다시 시도합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度传感器已停止响应。iSensa会自动持续重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度感測器已停止回應。iSensa會自動持續重試。"
          }
        }
      }
    },
    "Temperature, memory, storage and battery are within the expected range.": {
      "localizations": {
