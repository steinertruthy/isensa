    "%@ is open. Quit it first.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está aberto. Encerre-o primeiro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierta. Ciérrala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est ouverte. Quittez-la d’abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist geöffnet. Beende die App zuerst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è aperta. Chiudila prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が開いています。先に終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 열려 있습니다. 먼저 종료하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已打开。请先退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已開啟。請先結束。"
          }
        }
      }
    },
    "%@ items moved to the Trash, %@ freed": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ itens movidos para o Lixo, %2$@ liberados"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ítems trasladados a la Papelera, %2$@ liberados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ éléments placés dans la corbeille, %2$@ libérés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Objekte in den Papierkorb gelegt, %2$@ frei"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ elementi spostati nel Cestino, %2$@ liberati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@項目をゴミ箱に入れ、%2$@を解放しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@개 항목을 휴지통으로 이동, %2$@ 확보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将%1$@个项目移到废纸篓，释放了%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將%1$@個項目丟到垃圾桶，釋放了%2$@"
          }
        }
      }
    },
    "%@ left. Connect the charger to keep working.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %@. Conecte o carregador para continuar trabalhando."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda %@. Conecta el cargador para seguir trabajando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@. Branchez le chargeur pour continuer à travailler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@. Schließe das Netzteil an, um weiterzuarbeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta il %@. Collega l’alimentatore per continuare a lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%@です。作業を続けるには電源アダプタを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 남았습니다. 계속 작업하려면 충전기를 연결하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余%@。请连接充电器以继续工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘%@。請連接充電器以繼續工作。"
          }
        }
      }
    },
    "%@ mounted disk images. Ejecting one does not delete its file.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ imagens de disco montadas. Ejetar uma não apaga o arquivo dela."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ imágenes de disco montadas. Expulsar una no elimina su archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ images disque montées. Éjecter une image ne supprime pas son fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Image(s) aktiviert. Beim Auswerfen wird die Datei nicht gelöscht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ immagini disco montate. Espellerne una non ne elimina il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@個のディスクイメージがマウントされています。取り出してもファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지 %@개가 마운트되어 있습니다. 추출해도 파일은 삭제되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已装载%@个磁盘映像。推出映像不会删除其文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已裝載%@個磁碟映像檔。退出映像檔不會刪除其檔案。"
          }
        }
      }
    },
