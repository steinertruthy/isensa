    "Temperatures and fans refresh at half this rate. Longer intervals use less energy.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperaturas e ventiladores atualizam na metade dessa frequência. Intervalos maiores consomem menos energia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las temperaturas y los ventiladores se actualizan a la mitad de este ritmo. Los intervalos más largos consumen menos energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les températures et les ventilateurs s’actualisent deux fois moins souvent. Des intervalles plus longs consomment moins d’énergie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperaturen und Lüfter werden halb so oft aktualisiert. Längere Intervalle verbrauchen weniger Energie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature e ventole si aggiornano con metà di questa frequenza. Intervalli più lunghi consumano meno energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度とファンはこの半分の頻度で更新されます。間隔が長いほどエネルギー消費が少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도와 팬은 이 빈도의 절반으로 업데이트됩니다. 간격이 길수록 에너지를 덜 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度和风扇以此频率的一半刷新。间隔越长，能耗越低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度和風扇以此頻率的一半更新。間隔越長，耗電越少。"
          }
        }
      }
    },
