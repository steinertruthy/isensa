          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控えめ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄임"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少"
          }
        }
      }
    },
    "Reduced replaces movement with short fades. Off shows changes instantly.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzido troca o movimento por transições suaves. Desativado mostra as mudanças na hora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducido sustituye el movimiento por fundidos breves. Desactivado muestra los cambios al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit remplace le mouvement par de courts fondus. Désactivé affiche les changements immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Reduziert“ ersetzt Bewegung durch kurze Überblendungen. „Aus“ zeigt Änderungen sofort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridotto sostituisce il movimento con brevi dissolvenze. No mostra le modifiche all’istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「控えめ」では動きを短いフェードに置き換えます。「オフ」では変化をすぐに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄임은 움직임을 짧은 페이드로 바꿉니다. 끔은 변화를 즉시 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“减弱”会以短暂的淡入淡出代替移动。“关闭”会立即显示变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「減少」會以短暫的淡入淡出取代移動。「關閉」會立即顯示變化。"
          }
        }
      }
    },
