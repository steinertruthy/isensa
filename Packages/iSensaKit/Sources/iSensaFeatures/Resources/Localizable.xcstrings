    "macOS is working hard to free memory. Closing apps you are not using will help.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS está se esforçando para liberar memória. Fechar apps que você não está usando vai ajudar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS se está esforzando para liberar memoria. Cerrar las apps que no usas ayudará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peine à libérer de la mémoire. Fermer les apps inutilisées aidera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS muss sich anstrengen, um Arbeitsspeicher freizugeben. Das Beenden ungenutzter Apps hilft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS si sta sforzando per liberare memoria. Chiudere le app che non usi aiuterà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがメモリの解放に苦労しています。使っていないAppを終了すると改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 메모리를 확보하느라 애쓰고 있습니다. 사용하지 않는 앱을 종료하면 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在努力释放内存。退出不使用的App会有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS正在努力釋放記憶體。結束未使用的App會有幫助。"
          }
        }
      }
    },
    "macOS recommends checking the battery (%@).": {
