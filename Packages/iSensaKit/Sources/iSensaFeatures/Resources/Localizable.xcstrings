    "Items go to the Trash. You can put them back until you empty it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens vão para o Lixo. Você pode devolvê-los até esvaziá-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems van a la Papelera. Puedes recuperarlos hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments vont dans la corbeille. Vous pouvez les remettre en place tant que vous ne l’avez pas vidée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Objekte kommen in den Papierkorb. Bis du ihn leerst, kannst du sie zurücklegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi vanno nel Cestino. Puoi ripristinarli finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目はゴミ箱に入ります。ゴミ箱を空にするまで元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 휴지통으로 이동합니다. 휴지통을 비우기 전까지 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目会移到废纸篓。清倒废纸篓前都可以放回原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目會丟到垃圾桶。清空垃圾桶前都可以放回原處。"
          }
        }
      }
    },
