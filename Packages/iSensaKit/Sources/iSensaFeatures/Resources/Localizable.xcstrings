    "Drag the points to shape the curve. Speed never drops as the temperature rises, and the last point is always full speed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os pontos para moldar a curva. A velocidade nunca cai quando a temperatura sobe, e o último ponto é sempre a velocidade máxima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los puntos para dar forma a la curva. La velocidad nunca baja cuando sube la temperatura, y el último punto siempre es la velocidad máxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les points pour façonner la courbe. La vitesse ne baisse jamais quand la température monte, et le dernier point est toujours la vitesse maximale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Punkte, um die Kurve zu formen. Die Drehzahl sinkt nie, wenn die Temperatur steigt, und der letzte Punkt ist immer volle Drehzahl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i punti per modellare la curva. La velocità non scende mai quando la temperatura sale, e l'ultimo punto è sempre la velocità massima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントをドラッグしてカーブを調整します。温度が上がると速度が下がることはなく、最後のポイントは常に最大速度です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 드래그하여 커브를 조정하세요. 온도가 오를 때 속도가 내려가지 않으며, 마지막 점은 항상 최대 속도입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移各点以调整曲线。温度上升时转速不会下降，最后一个点始终为最高转速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移各點以調整曲線。溫度上升時轉速不會下降，最後一個點一律為最高轉速。"
          }
        }
      }
    },
    "Drag to reorder. With no indicator enabled, iSensa shows only its icon.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Sem indicadores ativos, o iSensa mostra apenas seu ícone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Sin indicadores activados, iSensa muestra solo su icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Si aucun indicateur n’est activé, iSensa n’affiche que son icône."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Ohne aktivierte Anzeigen zeigt iSensa nur sein Symbol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Senza indicatori attivi, iSensa mostra solo la sua icona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。インジケータがすべてオフの場合、iSensaはアイコンだけを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하십시오. 표시기가 모두 꺼져 있으면 iSensa는 아이콘만 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。未启用任何指示器时，iSensa仅显示其图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。未啟用任何指示器時，iSensa只會顯示其圖像。"
          }
        }
      }
    },
