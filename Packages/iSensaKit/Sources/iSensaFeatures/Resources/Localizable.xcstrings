    "Percentage of range places the current speed between the fan's minimum and maximum.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porcentagem da faixa posiciona a velocidade atual entre o mínimo e o máximo do ventilador."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El porcentaje del rango sitúa la velocidad actual entre el mínimo y el máximo del ventilador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pourcentage de la plage situe la vitesse actuelle entre le minimum et le maximum du ventilateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Prozent des Bereichs“ zeigt die aktuelle Drehzahl zwischen Minimum und Maximum des Lüfters."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La percentuale dell’intervallo colloca la velocità attuale tra il minimo e il massimo della ventola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲に対する割合では、現在の速度をファンの最小値と最大値の間の位置で示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위 대비 비율은 현재 속도를 팬의 최소와 최대 사이에서의 위치로 나타냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围百分比表示当前转速在风扇最低与最高转速之间的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範圍百分比表示目前轉速在風扇最低與最高轉速之間的位置。"
          }
        }
      }
    },
