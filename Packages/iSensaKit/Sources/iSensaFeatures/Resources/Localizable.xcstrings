        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@中有%1$@可用"
          }
        }
      }
    },
    "%@ available on your startup disk.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponíveis no disco de inicialização."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles en el disco de arranque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles sur le disque de démarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf dem Startvolume verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibili sul disco di avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクに%@の空きがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크에 %@ 사용 가능."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘上有%@可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟上有%@可用。"
          }
        }
      }
    },
    "%@ files analyzed %@": {
      "localizations": {
