        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sensores desconocidos conservan su clave original. Los favoritos siempre se muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capteurs inconnus conservent leur clé d’origine. Les favoris sont toujours affichés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte Sensoren behalten ihren ursprünglichen Schlüssel. Favoriten werden immer angezeigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sensori sconosciuti mantengono la chiave originale. I preferiti vengono sempre mostrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なセンサーは元のキーのまま表示されます。お気に入りは常に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 센서는 원래 키를 유지합니다. 즐겨찾기는 항상 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知传感器会保留原始键。个人收藏始终显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知感測器會保留原始鍵。喜好項目一律顯示。"
          }
        }
      }
    },
