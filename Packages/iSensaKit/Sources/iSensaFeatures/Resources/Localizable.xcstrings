    "Manage backups in Finder: select your device, then Manage Backups. Delete only the ones you no longer need.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie os backups no Finder: selecione o dispositivo e clique em Gerenciar Backups. Apague só os que não precisa mais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona las copias en el Finder: selecciona el dispositivo y luego Gestionar copias de seguridad. Elimina solo las que ya no necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les sauvegardes dans le Finder : sélectionnez l’appareil, puis Gérer les sauvegardes. Supprimez uniquement celles dont vous n’avez plus besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Backups im Finder: Wähle dein Gerät und dann „Backups verwalten“. Lösche nur, was du nicht mehr brauchst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i backup nel Finder: seleziona il dispositivo, poi Gestisci backup. Elimina solo quelli che non ti servono più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでデバイスを選択し、「バックアップを管理」でバックアップを管理してください。不要なものだけを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 기기를 선택한 다음 백업 관리를 클릭하십시오. 더 이상 필요 없는 백업만 삭제하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中选择你的设备，然后点按“管理备份”。仅删除不再需要的备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在Finder中選擇你的裝置，然後按一下「管理備份」。僅刪除不再需要的備份。"
          }
        }
      }
    },
