    "Higher is better; above 25 dB is a solid connection.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto maior, melhor; acima de 25 dB a conexão é estável."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más alto, mejor; por encima de 25 dB la conexión es sólida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus c’est élevé, mieux c’est ; au-delà de 25 dB, la connexion est solide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher ist besser; über 25 dB ist die Verbindung stabil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più è alto, meglio è; sopra i 25 dB la connessione è solida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いほど良好です。25dBを超えていれば安定した接続です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높을수록 좋으며, 25dB 이상이면 안정적인 연결입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越高越好；超过25 dB即为稳定连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越高越好；超過25 dB即為穩定連線。"
          }
        }
      }
    },
