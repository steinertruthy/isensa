    "iCloud Drive and other cloud folders are not analyzed: their apps decide which files stay on this Mac.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Drive e outras pastas na nuvem não são analisados: os apps deles decidem quais arquivos ficam neste Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive y otras carpetas en la nube no se analizan: sus apps deciden qué archivos se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive et les autres dossiers cloud ne sont pas analysés : leurs apps décident quels fichiers restent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive und andere Cloud-Ordner werden nicht analysiert: Ihre Apps entscheiden, welche Dateien auf diesem Mac bleiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive e le altre cartelle cloud non vengono analizzati: sono le loro app a decidere quali file restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Driveやほかのクラウドフォルダは分析しません。どのファイルをこのMacに残すかは、それぞれのアプリが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive 및 기타 클라우드 폴더는 분석하지 않습니다. 이 Mac에 남길 파일은 해당 앱이 결정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会分析iCloud云盘和其他云文件夹：由它们的App决定哪些文件保留在这台Mac上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會分析iCloud雲碟和其他雲端檔案夾：由它們的App決定哪些檔案保留在這部Mac上。"
          }
        }
      }
    },
