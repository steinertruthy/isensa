    "Available space includes purgeable space macOS can free automatically, as shown in Finder.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço disponível inclui o espaço removível que o macOS libera automaticamente, como no Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio disponible incluye el espacio purgable que macOS puede liberar automáticamente, como en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace disponible inclut l’espace purgeable que macOS peut libérer automatiquement, comme dans le Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verfügbare Speicherplatz umfasst löschbaren Speicher, den macOS automatisch freigeben kann – wie im Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio disponibile include lo spazio eliminabile che macOS può liberare automaticamente, come nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な容量には、Finderと同様にmacOSが自動的に解放できるパージ可能な容量が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능 공간에는 Finder와 마찬가지로 macOS가 자동으로 확보할 수 있는 제거 가능 공간이 포함됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间包括macOS可自动释放的可清除空间，与“访达”中显示的一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間包含macOS可自動釋放的可清除空間，與「Finder」中顯示的相同。"
          }
        }
      }
    },
