    "Turn it on in Settings › History to keep a record.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-o em Ajustes › Histórico para manter um registro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes › Historial para llevar un registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages › Historique pour conserver un historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere ihn unter „Einstellungen“ › „Verlauf“, um Daten aufzuzeichnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivala in Impostazioni › Cronologia per tenere una registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を残すには「設定」›「履歴」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 남기려면 설정 › 기록에서 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”›“历史记录”中开启以保留记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」›「歷史記錄」中開啟以保留記錄。"
          }
        }
      }
    },
    "Turn on FileVault in System Settings › Privacy & Security to encrypt your data.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o FileVault em Ajustes do Sistema › Privacidade e Segurança para criptografar seus dados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa FileVault en Ajustes del Sistema › Privacidad y seguridad para cifrar tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez FileVault dans Réglages Système › Confidentialité et sécurité pour chiffrer vos données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere FileVault unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“, um deine Daten zu verschlüsseln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva FileVault in Impostazioni di Sistema › Privacy e sicurezza per crittografare i tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを暗号化するには、「システム設定」›「プライバシーとセキュリティ」でFileVaultをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 암호화하려면 시스템 설정 › 개인정보 보호 및 보안에서 FileVault를 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要加密你的数据，请在“系统设置”›“隐私与安全性”中打开文件保险箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要加密你的資料，請在「系統設定」›「隱私權與安全性」中開啟FileVault。"
          }
        }
      }
    },
    "Turn on history in Settings › History to see how your disk space changes over time.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o histórico em Ajustes › Histórico para ver como o espaço em disco muda com o tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el historial en Ajustes › Historial para ver cómo cambia el espacio en disco con el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’historique dans Réglages › Historique pour voir l’évolution de l’espace disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Verlauf unter „Einstellungen“ › „Verlauf“, um zu sehen, wie sich dein Speicherplatz entwickelt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la cronologia in Impostazioni › Cronologia per vedere come cambia lo spazio su disco nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク容量の推移を確認するには、「設定」›「履歴」で履歴をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 공간의 변화를 보려면 설정 › 기록에서 기록을 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要查看磁盘空间随时间的变化，请在“设置”›“历史记录”中打开历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要查看磁碟空間隨時間的變化，請在「設定」›「歷史記錄」中開啟歷史記錄。"
          }
        }
      }
    },
    "Turn on notifications in Settings › Notifications for these alerts to be sent.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações em Ajustes › Notificações para que estes alertas sejam enviados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones en Ajustes › Notificaciones para que se envíen estas alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications dans Réglages › Notifications pour recevoir ces alertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen unter „Einstellungen“ › „Mitteilungen“, damit diese Hinweise gesendet werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche in Impostazioni › Notifiche per ricevere questi avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアラートを送信するには、「設定」›「通知」で通知をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 경고를 받으려면 설정 › 알림에서 알림을 켜십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”›“通知”中开启通知，以便发送这些警告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」›「通知」中開啟通知，以傳送這些警示。"
          }
        }
      }
    },
