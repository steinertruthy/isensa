    "Appearance, menu bar, alerts, favorites and every other preference return to their defaults.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparência, barra de menus, alertas, favoritos e todas as outras preferências voltam ao padrão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia, la barra de menús, las alertas, los favoritos y el resto de preferencias vuelven a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence, la barre des menus, les alertes, les favoris et toutes les autres préférences reprennent leurs valeurs par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild, Menüleiste, Hinweise, Favoriten und alle anderen Einstellungen werden auf die Standardwerte zurückgesetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetto, barra dei menu, avvisi, preferiti e tutte le altre preferenze tornano ai valori predefiniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観、メニューバー、アラート、お気に入りなど、すべての設定がデフォルトに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양, 메뉴 막대, 경고, 즐겨찾기 등 모든 설정이 기본값으로 돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观、菜单栏、警告、个人收藏及其他所有偏好设置都将恢复默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀、選單列、警示、喜好項目及其他所有偏好設定都會回復為預設值。"
          }
        }
      }
    },
    "Approve iSensa in System Settings › General › Login Items.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove o iSensa em Ajustes do Sistema › Geral › Itens de Início."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba iSensa en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez iSensa dans Réglages Système › Général › Ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmige iSensa unter „Systemeinstellungen“ › „Allgemein“ › „Anmeldeobjekte“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva iSensa in Impostazioni di Sistema › Generali › Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「一般」›「ログイン項目」でiSensaを承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 일반 › 로그인 항목에서 iSensa를 승인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”›“通用”›“登录项”中批准iSensa。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
