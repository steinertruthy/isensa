    "Stacked places two indicators in one column, using about half the width when the menu bar is crowded.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo empilhado coloca dois indicadores por coluna, usando cerca de metade da largura quando a barra de menus está cheia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo apilado coloca dos indicadores en una columna y ocupa aproximadamente la mitad del ancho cuando la barra de menús está llena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode empilé place deux indicateurs par colonne et occupe environ la moitié de la largeur lorsque la barre des menus est chargée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Gestapelt“ ordnet zwei Anzeigen in einer Spalte an und benötigt etwa die halbe Breite, wenn die Menüleiste voll ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposizione impilata mette due indicatori in una colonna e occupa circa metà della larghezza quando la barra dei menu è piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「縦に重ねる」では1列に2つのインジケータを並べ、メニューバーが混み合っているときに幅を約半分に抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓기는 한 열에 표시기 두 개를 배치하여 메뉴 막대가 붐빌 때 너비를 약 절반으로 줄입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“堆叠”会在一列中放置两个指示器，在菜单栏拥挤时只占约一半宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「堆疊」會在一欄中放置兩個指示器，在選單列擁擠時只佔約一半寬度。"
          }
        }
      }
    },
