      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o app e os arquivos que ele deixou para o Lixo, depois que você revisar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traslada la app y los archivos que dejó a la Papelera, después de que los revises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place l’app et les fichiers qu’elle a laissés dans la corbeille, après votre vérification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die App und die von ihr hinterlassenen Dateien nach deiner Prüfung in den Papierkorb."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta nel Cestino l’app e i file che ha lasciato, dopo che li hai controllati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後、アプリと残されたファイルをゴミ箱に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토한 후 앱과 앱이 남긴 파일을 휴지통으로 옮깁니다."
