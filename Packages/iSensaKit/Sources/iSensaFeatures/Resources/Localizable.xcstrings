    "The internal SSD has recorded %@ media errors. Keep your backups current.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SSD interno registrou %@ erros de mídia. Mantenha seus backups em dia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SSD interno ha registrado %@ errores de medio. Mantén tus copias de seguridad al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SSD interne a enregistré %@ erreurs de support. Gardez vos sauvegardes à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die interne SSD hat %@ Medienfehler registriert. Halte deine Backups aktuell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’SSD interno ha registrato %@ errori del supporto. Tieni aggiornati i backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵SSDで%@件のメディアエラーが記録されています。バックアップを最新の状態に保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 SSD에 미디어 오류가 %@건 기록되었습니다. 백업을 최신 상태로 유지하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置SSD已记录%@个介质错误。请及时更新备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建SSD已記錄%@個媒體錯誤。請隨時更新備份。"
          }
        }
      }
    },
    "The internal SSD reports a critical condition. Back up your data.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SSD interno relata uma condição crítica. Faça backup dos seus dados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SSD interno informa de un estado crítico. Haz una copia de seguridad de tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SSD interne signale un état critique. Sauvegardez vos données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die interne SSD meldet einen kritischen Zustand. Sichere deine Daten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’SSD interno segnala una condizione critica. Esegui un backup dei dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵SSDが危険な状態を報告しています。データをバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 SSD가 위험 상태를 보고했습니다. 데이터를 백업하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置SSD报告了严重状况。请备份你的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建SSD回報了嚴重狀況。請備份你的資料。"
          }
        }
      }
    },
    "The new language applies after iSensa restarts.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo idioma passa a valer depois que o iSensa reiniciar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplicará cuando iSensa se reinicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’appliquera au redémarrage de iSensa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache gilt nach einem Neustart von iSensa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova lingua sarà applicata al riavvio di iSensa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語はiSensaを再起動すると適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 iSensa를 재시동한 후 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新语言将在iSensa重新启动后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新語言會在iSensa重新啟動後生效。"
          }
        }
      }
    },
    "The startup disk lost %@ of free space in the last 30 minutes. Storage › Activity by app shows what is writing.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de inicialização perdeu %@ de espaço livre nos últimos 30 minutos. Armazenamento › Atividade por app mostra o que está gravando."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco de arranque ha perdido %@ de espacio libre en los últimos 30 minutos. Almacenamiento › Actividad por app muestra qué está escribiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque de démarrage a perdu %@ d’espace libre au cours des 30 dernières minutes. Stockage › Activité par app montre ce qui écrit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startvolume hat in den letzten 30 Minuten %@ freien Speicher verloren. „Speicher“ › „Aktivität nach App“ zeigt, was schreibt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco di avvio ha perso %@ di spazio libero negli ultimi 30 minuti. Archiviazione › Attività per app mostra cosa sta scrivendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクの空き容量が過去30分間で%@減りました。「ストレージ」›「アプリ別のアクティビティ」で書き込んでいるものを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 30분 동안 시동 디스크의 여유 공간이 %@ 줄었습니다. 저장 공간 › 앱별 활동에서 무엇이 쓰고 있는지 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘在过去30分钟内减少了%@可用空间。“储存空间”›“按App的活动”会显示正在写入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟在過去30分鐘內減少了%@可用空間。「儲存空間」›「依App的活動」會顯示正在寫入的內容。"
          }
        }
      }
    },
