    "Docker keeps images and volumes in one disk file. Free it in Docker Desktop › Troubleshoot › Clean / Purge data, or with “docker system prune”.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Docker guarda imagens e volumes num único arquivo de disco. Libere espaço em Docker Desktop › Troubleshoot › Clean / Purge data, ou com “docker system prune”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker guarda imágenes y volúmenes en un único archivo de disco. Libera espacio en Docker Desktop › Troubleshoot › Clean / Purge data, o con “docker system prune”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker conserve images et volumes dans un seul fichier disque. Libérez-le dans Docker Desktop › Troubleshoot › Clean / Purge data, ou avec « docker system prune »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker speichert Images und Volumes in einer Datei. Gib Platz frei unter „Docker Desktop“ › „Troubleshoot“ › „Clean / Purge data“ oder mit „docker system prune“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker conserva immagini e volumi in un unico file disco. Libera spazio in Docker Desktop › Troubleshoot › Clean / Purge data, o con “docker system prune”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockerはイメージとボリュームを1つのディスクファイルに保存します。Docker Desktop › Troubleshoot › Clean / Purge dataか、「docker system prune」で解放してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker는 이미지와 볼륨을 하나의 디스크 파일에 보관합니다. Docker Desktop › Troubleshoot › Clean / Purge data 또는 “docker system prune”으로 확보하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker将映像和卷保存在一个磁盘文件中。请在Docker Desktop › Troubleshoot › Clean / Purge data中释放，或使用“docker system prune”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker將映像和卷宗保存在一個磁碟檔案中。請在Docker Desktop › Troubleshoot › Clean / Purge data中釋放，或使用「docker system prune」。"
          }
        }
      }
    },
