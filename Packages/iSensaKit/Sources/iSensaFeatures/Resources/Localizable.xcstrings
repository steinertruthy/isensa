    "Xcode recreates these the next time you build. Projects build more slowly the first time.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode os recria no próximo build. Os projetos demoram mais para compilar na primeira vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode los vuelve a crear en la siguiente compilación. La primera vez los proyectos tardan más en compilarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode les recrée à la prochaine compilation. La première compilation des projets est plus lente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode erstellt sie beim nächsten Build neu. Projekte brauchen beim ersten Mal länger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode li ricrea alla prossima compilazione. La prima volta i progetti si compilano più lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のビルド時にXcodeが再作成します。最初のビルドは時間がかかります。"
