    "Includes display, SSD and everything else, as reported by the SMC.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui tela, SSD e todo o resto, conforme informado pelo SMC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye pantalla, SSD y todo lo demás, según el SMC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprend l’écran, le SSD et tout le reste, selon le SMC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfasst Display, SSD und alles andere laut SMC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include schermo, SSD e tutto il resto, secondo l’SMC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイやSSDなどすべてを含む、SMCが報告した値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SMC가 보고한 디스플레이, SSD 등 모든 항목을 포함합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
