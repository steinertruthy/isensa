    "Your curve leaves the fans to macOS below %1$@ and reaches full speed at %2$@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua curva deixa os ventiladores com o macOS abaixo de %1$@ e chega à velocidade máxima em %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu curva deja los ventiladores a macOS por debajo de %1$@ y alcanza la velocidad máxima a %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre courbe laisse les ventilateurs à macOS sous %1$@ et atteint la vitesse maximale à %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kurve überlässt die Lüfter unter %1$@ macOS und erreicht die volle Drehzahl bei %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua curva lascia le ventole a macOS sotto %1$@ e raggiunge la velocità massima a %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカーブは %1$@ 未満ではファンを macOS に任せ、%2$@ で最大速度になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커브는 %1$@ 미만에서는 팬을 macOS에 맡기고 %2$@에서 최대 속도에 도달합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的曲线在低于 %1$@ 时将风扇交给 macOS，并在 %2$@ 时达到最高转速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的曲線在低於 %1$@ 時將風扇交給 macOS，並在 %2$@ 時達到最高轉速。"
          }
        }
      }
    },
    "Your curve reaches full speed at %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
