    "Too hot for a fixed speed below maximum, so macOS is controlling the fans.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quente demais para uma velocidade fixa abaixo do máximo, então o macOS está controlando os ventiladores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace demasiado calor para una velocidad fija por debajo del máximo, así que macOS controla los ventiladores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop chaud pour une vitesse fixe inférieure au maximum : macOS contrôle les ventilateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu heiß für eine feste Drehzahl unter dem Maximum, daher steuert macOS die Lüfter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo caldo per una velocità fissa inferiore al massimo, quindi macOS controlla le ventole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大未満の固定速度では温度が高すぎるため、macOSがファンを制御しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 미만의 고정 속도로는 너무 뜨거워 macOS가 팬을 제어합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度过高，不适合低于最大值的固定速度，因此由 macOS 控制风扇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度過高，不適合低於最大值的固定速度，因此由 macOS 控制風扇。"
          }
        }
      }
    },
