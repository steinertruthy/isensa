    "Estimate: the recent pace extended in a straight line. A large download or cleanup changes it quickly.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa: o ritmo recente prolongado em linha reta. Um download grande ou uma limpeza muda isso rapidamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación: el ritmo reciente prolongado en línea recta. Una descarga grande o una limpieza lo cambian rápidamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation : le rythme récent prolongé en ligne droite. Un gros téléchargement ou un nettoyage la modifie rapidement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzung: das jüngste Tempo, geradlinig fortgeschrieben. Ein großer Download oder eine Aufräumaktion ändert sie schnell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima: il ritmo recente prolungato in linea retta. Un download grande o una pulizia la cambiano rapidamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定値：最近のペースを直線的に延ばしたものです。大きなダウンロードや整理ですぐに変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정값: 최근 속도를 직선으로 연장한 값입니다. 큰 다운로드나 정리로 금방 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值：将近期的速度按直线延伸。大量下载或清理会很快改变它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "估算值：將近期的速度依直線延伸。大量下載或清理會很快改變它。"
          }
        }
      }
    },
