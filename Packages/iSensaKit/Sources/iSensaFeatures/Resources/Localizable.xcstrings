    "Reduce Motion is on in System Settings, so iSensa uses short fades instead of movement.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A opção Reduzir Movimento está ativa nos Ajustes do Sistema, então o iSensa usa transições suaves em vez de movimento."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir movimiento está activado en Ajustes del Sistema, así que iSensa usa fundidos breves en lugar de movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les animations est activé dans Réglages Système : iSensa utilise donc de courts fondus au lieu de mouvements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bewegung reduzieren“ ist in den Systemeinstellungen aktiviert, daher verwendet iSensa kurze Überblendungen statt Bewegung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Riduci movimento” è attivo in Impostazioni di Sistema, quindi iSensa usa brevi dissolvenze al posto del movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」で「視差効果を減らす」がオンのため、iSensaは動きの代わりに短いフェードを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 동작 줄이기가 켜져 있어 iSensa는 움직임 대신 짧은 페이드를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统设置”中已开启“减弱动态效果”，因此iSensa使用短暂的淡入淡出代替移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「系統設定」中已開啟「減少動態效果」，因此iSensa使用短暫的淡入淡出取代移動。"
          }
        }
      }
    },
    "Reduced": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzido"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducido"
          }
