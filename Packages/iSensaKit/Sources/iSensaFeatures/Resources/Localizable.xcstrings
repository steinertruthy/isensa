          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦に重ねる（コンパクト）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓기(간결)"
          }
        },
        "zh-Hans": {
