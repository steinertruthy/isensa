    "Leave the fans to macOS below the first point": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar os ventiladores com o macOS abaixo do primeiro ponto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar los ventiladores a macOS por debajo del primer punto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser les ventilateurs à macOS sous le premier point"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lüfter unter dem ersten Punkt macOS überlassen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia le ventole a macOS sotto il primo punto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のポイント未満ではファンを macOS に任せる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 점 미만에서는 팬을 macOS에 맡기기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于第一个点时将风扇交给 macOS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於第一個點時將風扇交給 macOS"
          }
        }
      }
    },
    "Leaves the fans to macOS below %@, then follows the temperature.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa os ventiladores com o macOS abaixo de %@ e depois acompanha a temperatura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja los ventiladores a macOS por debajo de %@ y luego sigue la temperatura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les ventilateurs à macOS sous %@, puis suit la température."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlässt die Lüfter unter %@ macOS und folgt dann der Temperatur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia le ventole a macOS sotto %@, poi segue la temperatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@未満ではファンをmacOSに任せ、それ以上では温度に合わせて調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 미만에서는 팬을 macOS에 맡기고, 그 이상에서는 온도를 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 %@ 时交由 macOS 控制风扇，之后随温度调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 %@ 時交由 macOS 控制風扇，之後隨溫度調整。"
          }
        }
      }
    },
    "Leaves the fans to macOS below %@, then speeds up gently.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa os ventiladores com o macOS abaixo de %@ e depois acelera suavemente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja los ventiladores a macOS por debajo de %@ y luego acelera suavemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les ventilateurs à macOS sous %@, puis accélère en douceur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlässt die Lüfter unter %@ macOS und erhöht dann sanft die Drehzahl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia le ventole a macOS sotto %@, poi accelera gradualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@未満ではファンをmacOSに任せ、それ以上では穏やかに速度を上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 미만에서는 팬을 macOS에 맡기고, 그 이상에서는 부드럽게 속도를 높입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于 %@ 时交由 macOS 控制风扇，之后平缓提速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低於 %@ 時交由 macOS 控制風扇，之後平緩提速。"
          }
        }
      }
    },
