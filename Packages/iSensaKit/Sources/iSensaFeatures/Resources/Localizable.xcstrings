    "Debugging symbols for devices you connected to Xcode. Xcode downloads them again when needed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuração de dispositivos que você conectou ao Xcode. O Xcode os baixa de novo quando precisar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolos de depuración de los dispositivos que conectaste a Xcode. Xcode los vuelve a descargar cuando hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboles de débogage des appareils connectés à Xcode. Xcode les retélécharge au besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debugsymbole für Geräte, die du mit Xcode verbunden hast. Xcode lädt sie bei Bedarf erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simboli di debug dei dispositivi collegati a Xcode. Xcode li scarica di nuovo quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodeに接続したデバイス用のデバッグシンボルです。必要になるとXcodeが再ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode에 연결한 기기용 디버깅 기호입니다. 필요하면 Xcode가 다시 다운로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你连接到Xcode的设备的调试符号。需要时Xcode会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你連接到Xcode的裝置的除錯符號。需要時Xcode會重新下載。"
          }
        }
      }
    },
