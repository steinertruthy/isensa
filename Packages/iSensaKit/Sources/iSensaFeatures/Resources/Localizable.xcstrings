            "state": "translated",
            "value": "风扇随温度升高而加速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風扇隨溫度升高而加速。"
          }
        }
      }
    },
    "The fans stayed off: the Mac cooled itself without them.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ventiladores ficaram parados: o Mac se refrigerou sem eles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores no se encendieron: el Mac se refrigeró sin ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ventilateurs sont restés à l’arrêt : le Mac s’est refroidi sans eux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüfter blieben aus: Der Mac kühlte sich ohne sie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ventole sono rimaste ferme: il Mac si è raffreddato senza di esse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンは停止したままでした。Macはファンなしで冷却できていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬이 꺼진 상태를 유지했습니다. Mac이 팬 없이 냉각되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇一直未转动：Mac 无需风扇即可散热。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風扇一直未轉動：Mac 無需風扇即可散熱。"
          }
        }
      }
    },
