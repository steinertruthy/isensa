    "Your startup disk is close to full.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de inicialização está quase cheio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco de arranque está casi lleno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque de démarrage est presque plein."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Startvolume ist fast voll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco di avvio è quasi pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクがいっぱいになりそうです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크가 거의 가득 찼습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘快满了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟快滿了。"
          }
        }
      }
    },
    "Your startup disk is one APFS container shared by several volumes. They all draw from the same free space, so none of them has a fixed size.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de inicialização é um contêiner APFS compartilhado por vários volumes. Todos usam o mesmo espaço livre, então nenhum tem tamanho fixo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco de arranque es un contenedor APFS compartido por varios volúmenes. Todos usan el mismo espacio libre, así que ninguno tiene un tamaño fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque de démarrage est un conteneur APFS partagé par plusieurs volumes. Ils puisent tous dans le même espace libre : aucun n’a de taille fixe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Startvolume ist ein APFS-Container, den sich mehrere Volumes teilen. Alle nutzen denselben freien Speicher, daher hat keines eine feste Größe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco di avvio è un contenitore APFS condiviso da più volumi. Tutti attingono allo stesso spazio libero, quindi nessuno ha una dimensione fissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクは、複数のボリュームが共有する1つのAPFSコンテナです。どのボリュームも同じ空き容量を使うため、固定サイズはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크는 여러 볼륨이 공유하는 하나의 APFS 컨테이너입니다. 모두 같은 여유 공간을 사용하므로 크기가 고정된 볼륨은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘是由多个宗卷共享的一个APFS容器。它们都使用同一份可用空间，因此没有任何宗卷有固定大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟是由多個宗卷共用的一個APFS容器。它們都使用同一份可用空間，因此沒有任何宗卷有固定大小。"
          }
        }
      }
    },
