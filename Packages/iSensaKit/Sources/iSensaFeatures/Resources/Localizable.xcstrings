          }
        }
      }
    },
    "The fans sped up as the temperature rose, usually from about %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ventiladores aceleraram conforme a temperatura subiu, geralmente a partir de cerca de %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores aceleraron a medida que subía la temperatura, normalmente a partir de unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ventilateurs ont accéléré avec la température, généralement à partir d’environ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüfter liefen mit steigender Temperatur schneller, meist ab etwa %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ventole hanno accelerato con l’aumento della temperatura, di solito a partire da circa %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度の上昇に合わせてファンが加速しました。たいてい約%@からです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도가 오르면서 팬이 빨라졌습니다. 보통 약 %@부터입니다."
          }
        },
        "zh-Hans": {
