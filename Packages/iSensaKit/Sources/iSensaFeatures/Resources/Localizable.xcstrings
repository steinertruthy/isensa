          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments absents de ce Mac, comme une batterie ou des ventilateurs, n’apparaissent jamais."
          }
        },
        "de": {
          "stringUnit": {
