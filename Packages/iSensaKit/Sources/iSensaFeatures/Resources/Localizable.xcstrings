    "Only %@ of the startup disk is free. Delete files you no longer need or move them to another drive.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só %@ do disco de inicialização está livre. Apague arquivos de que não precisa mais ou mova-os para outra unidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo queda libre %@ del disco de arranque. Elimina los archivos que ya no necesites o muévelos a otra unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@ du disque de démarrage est libre. Supprimez les fichiers inutiles ou déplacez-les vers un autre disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %@ des Startvolumes sind frei. Lösche nicht mehr benötigte Dateien oder verschiebe sie auf ein anderes Laufwerk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il %@ del disco di avvio è libero. Elimina i file che non ti servono più o spostali su un’altra unità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクの空きは%@しかありません。不要なファイルを削除するか、別のドライブに移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크의 여유 공간이 %@뿐입니다. 필요 없는 파일을 삭제하거나 다른 드라이브로 옮기십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动磁盘仅剩%@可用。请删除不再需要的文件，或将其移到其他驱动器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動磁碟只剩%@可用。請刪除不再需要的檔案，或將其移到其他磁碟。"
          }
        }
      }
    },
