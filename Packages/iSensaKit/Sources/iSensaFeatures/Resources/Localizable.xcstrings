    "The fans return to automatic and macOS asks for your password to remove the helper.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ventiladores voltam ao automático e o macOS pede sua senha para remover o auxiliar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ventiladores vuelven al modo automático y macOS te pide la contraseña para eliminar el asistente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ventilateurs repassent en automatique et macOS demande votre mot de passe pour supprimer l’assistant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüfter kehren zur automatischen Steuerung zurück, und macOS fragt zum Entfernen des Hilfsprogramms nach deinem Passwort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ventole tornano in automatico e macOS chiede la password per rimuovere l’helper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンは自動制御に戻り、ヘルパーの削除時にmacOSがパスワードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬이 자동 제어로 돌아가고, 도우미를 제거할 때 macOS가 암호를 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
