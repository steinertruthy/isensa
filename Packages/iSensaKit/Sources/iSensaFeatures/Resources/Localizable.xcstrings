    "Fan limits are unavailable, so macOS is controlling the fans.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites dos ventiladores não estão disponíveis, então o macOS está controlando os ventiladores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites de los ventiladores no están disponibles, así que macOS los controla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites des ventilateurs ne sont pas disponibles : macOS les contrôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüftergrenzen sind nicht verfügbar, daher steuert macOS die Lüfter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti delle ventole non sono disponibili, quindi macOS le controlla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンの限界値を取得できないため、macOSがファンを制御しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
