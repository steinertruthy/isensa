          }
        }
      }
    },
    "Latency is how long the disk takes, on average, to complete one read or write. It rises when the disk is the bottleneck, even if little data moves.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Latência é quanto o disco leva, em média, para concluir uma leitura ou gravação. Ela sobe quando o disco é o gargalo, mesmo com poucos dados sendo transferidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La latencia es lo que tarda el disco, de media, en completar una lectura o escritura. Sube cuando el disco es el cuello de botella, aunque se muevan pocos datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latence est le temps moyen que met le disque pour terminer une lecture ou une écriture. Elle augmente quand le disque est le goulot d’étranglement, même si peu de données circulent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Latenz gibt an, wie lange das Laufwerk im Schnitt für einen Lese- oder Schreibvorgang braucht. Sie steigt, wenn das Laufwerk der Engpass ist – auch wenn wenig Daten fließen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La latenza è il tempo medio che il disco impiega per completare una lettura o una scrittura. Aumenta quando il disco è il collo di bottiglia, anche se si spostano pochi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイテンシは、ディスクが1回の読み込みまたは書き込みを完了するまでの平均時間です。転送量が少なくても、ディスクがボトルネックになると上昇します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지연 시간은 디스크가 읽기 또는 쓰기 한 번을 마치는 데 걸리는 평균 시간입니다. 데이터 이동이 적어도 디스크가 병목일 때 늘어납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "延迟是磁盘完成一次读取或写入平均所需的时间。即使传输的数据很少，只要磁盘成为瓶颈，延迟就会升高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "延遲是磁碟完成一次讀取或寫入平均所需的時間。即使傳輸的資料很少，只要磁碟成為瓶頸，延遲就會升高。"
          }
        }
      }
    },
