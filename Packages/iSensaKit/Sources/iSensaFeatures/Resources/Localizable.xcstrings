    "The curve follows the hottest CPU core, averaged over a few seconds so brief spikes don't change the fan speed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A curva segue o núcleo mais quente da CPU, com média de alguns segundos para que picos breves não mudem a velocidade dos ventiladores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva sigue el núcleo más caliente de la CPU, promediado durante unos segundos para que los picos breves no cambien la velocidad de los ventiladores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La courbe suit le cœur du processeur le plus chaud, moyenné sur quelques secondes pour que de brefs pics ne modifient pas la vitesse des ventilateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurve folgt dem heißesten CPU-Kern, gemittelt über einige Sekunden, damit kurze Spitzen die Lüfterdrehzahl nicht ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La curva segue il core della CPU più caldo, mediato su alcuni secondi perché brevi picchi non cambino la velocità delle ventole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーブは最も高温の CPU コアに従います。短い急上昇でファンの速度が変わらないよう、数秒間で平均化しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커브는 가장 뜨거운 CPU 코어를 따릅니다. 짧은 급상승으로 팬 속도가 바뀌지 않도록 몇 초 동안 평균을 냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线跟随最热的 CPU 核心，并在几秒内取平均值，避免短暂峰值改变风扇转速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線跟隨最熱的 CPU 核心，並在幾秒內取平均值，避免短暫峰值改變風扇轉速。"
          }
        }
      }
    },
    "The data on this disk is encrypted with your login password.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados deste disco são criptografados com sua senha de login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
