    "Your Mac is under thermal pressure, so macOS is controlling the fans.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac está sob pressão térmica, então o macOS está controlando os ventiladores."
          }
        },
