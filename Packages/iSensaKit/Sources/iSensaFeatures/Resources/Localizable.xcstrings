    "Delete simulators you no longer use in Xcode › Settings › Components, or run “xcrun simctl delete unavailable” in Terminal.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague os simuladores que você não usa mais em Xcode › Ajustes › Componentes, ou rode “xcrun simctl delete unavailable” no Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los simuladores que ya no uses en Xcode › Ajustes › Componentes, o ejecuta “xcrun simctl delete unavailable” en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les simulateurs inutilisés dans Xcode › Réglages › Composants, ou exécutez « xcrun simctl delete unavailable » dans Terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche nicht mehr benötigte Simulatoren unter „Xcode“ › „Einstellungen“ › „Komponenten“ oder führe „xcrun simctl delete unavailable“ im Terminal aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i simulatori che non usi più in Xcode › Impostazioni › Componenti, oppure esegui “xcrun simctl delete unavailable” in Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使わなくなったシミュレータはXcode ›「設定」›「コンポーネント」で削除するか、ターミナルで「xcrun simctl delete unavailable」を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 시뮬레이터는 Xcode › 설정 › 구성 요소에서 삭제하거나 터미널에서 “xcrun simctl delete unavailable”을 실행하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在Xcode ›“设置”›“组件”中删除不再使用的模拟器，或在终端中运行“xcrun simctl delete unavailable”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在Xcode ›「設定」›「元件」中刪除不再使用的模擬器，或在終端機中執行「xcrun simctl delete unavailable」。"
          }
        }
      }
    },
