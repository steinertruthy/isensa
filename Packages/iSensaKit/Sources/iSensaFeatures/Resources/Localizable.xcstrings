          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles sur %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von %@ verfügbar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibili su %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@中%1$@が利用可能"
          }
        },
        "ko": {
