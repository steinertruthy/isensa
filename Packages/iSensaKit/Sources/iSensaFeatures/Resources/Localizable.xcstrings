    "Items in the Trash still take space until you empty it in Finder.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens no Lixo continuam ocupando espaço até você esvaziá-lo no Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ítems de la Papelera siguen ocupando espacio hasta que la vacíes en el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de la corbeille occupent de l’espace tant que vous ne la videz pas dans le Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte im Papierkorb belegen Platz, bis du ihn im Finder leerst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi nel Cestino occupano spazio finché non lo svuoti nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の項目は、Finderでゴミ箱を空にするまで容量を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통의 항목은 Finder에서 비울 때까지 공간을 차지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的项目在你于访达中清倒之前仍占用空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶中的項目在你於Finder中清空之前仍佔用空間。"
          }
        }
      }
    },
    "Items this Mac does not have, such as a battery or fans, never appear.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens que este Mac não tem, como bateria ou ventiladores, nunca aparecem."
          }
        },
        "es": {
