    "Experimental features read undocumented macOS interfaces and may change with macOS updates.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recursos experimentais leem interfaces não documentadas do macOS e podem mudar com atualizações do sistema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones experimentales leen interfaces no documentadas de macOS y pueden cambiar con las actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités expérimentales lisent des interfaces non documentées de macOS et peuvent changer avec les mises à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentelle Funktionen lesen nicht dokumentierte macOS-Schnittstellen und können sich mit macOS-Updates ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni sperimentali leggono interfacce di macOS non documentate e possono cambiare con gli aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試験運用中の機能は、文書化されていないmacOSのインターフェイスを読み取るため、macOSのアップデートで変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 기능은 문서화되지 않은 macOS 인터페이스를 읽으며 macOS 업데이트에 따라 달라질 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能会读取未公开的macOS接口，可能随macOS更新而变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性功能會讀取未公開的macOS介面，可能隨macOS更新而改變。"
          }
        }
      }
    },
