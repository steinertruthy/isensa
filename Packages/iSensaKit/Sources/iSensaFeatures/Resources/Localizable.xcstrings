    "Apps rebuild their caches when needed. Caches of open apps are kept.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps recriam seus caches quando precisam. Caches de apps abertos são mantidos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps reconstruyen sus cachés cuando las necesitan. Se conservan las cachés de las apps abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps reconstruisent leurs caches au besoin. Les caches des apps ouvertes sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erstellen ihre Caches bei Bedarf neu. Caches geöffneter Apps bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app ricreano le cache quando servono. Le cache delle app aperte vengono mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは必要に応じてキャッシュを再作成します。開いているアプリのキャッシュは残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 필요할 때 캐시를 다시 만듭니다. 열려 있는 앱의 캐시는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App会在需要时重建缓存。已打开App的缓存会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App會在需要時重建快取。已開啟App的快取會保留。"
          }
        }
      }
    },
