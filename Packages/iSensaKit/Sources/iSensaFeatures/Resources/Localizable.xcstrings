    "By default iSensa follows the language order in System Settings › General › Language & Region.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, o iSensa segue a ordem de idiomas de Ajustes do Sistema › Geral › Idioma e Região."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De forma predeterminada, iSensa sigue el orden de idiomas de Ajustes del Sistema › General › Idioma y región."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, iSensa suit l’ordre des langues de Réglages Système › Général › Langue et région."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig folgt iSensa der Sprachreihenfolge unter „Systemeinstellungen“ › „Allgemein“ › „Sprache & Region“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, iSensa segue l’ordine delle lingue di Impostazioni di Sistema › Generali › Lingua e Zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、iSensaは「システム設定」›「一般」›「言語と地域」の言語順に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 iSensa는 시스템 설정 › 일반 › 언어 및 지역의 언어 순서를 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，iSensa会遵循“系统设置”›“通用”›“语言与地区”中的语言顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
