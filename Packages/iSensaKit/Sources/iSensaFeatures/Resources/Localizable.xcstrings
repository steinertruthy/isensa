    "The fan controller did not accept the change, so macOS keeps control of the fans.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controlador dos ventiladores não aceitou a mudança, então o macOS continua controlando os ventiladores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de ventiladores no aceptó el cambio, así que macOS sigue controlándolos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôleur des ventilateurs n’a pas accepté la modification : macOS garde le contrôle des ventilateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lüftercontroller hat die Änderung nicht angenommen, daher behält macOS die Steuerung der Lüfter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controller delle ventole non ha accettato la modifica, quindi macOS mantiene il controllo delle ventole."
          }
        },
        "ja": {
          "stringUnit": {
