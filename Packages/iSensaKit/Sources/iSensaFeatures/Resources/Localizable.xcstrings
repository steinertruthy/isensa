    "macOS shows the network name only to apps with Location Services permission.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS só mostra o nome da rede para apps com permissão de Serviços de Localização."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS solo muestra el nombre de la red a las apps con permiso de Localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’affiche le nom du réseau qu’aux apps autorisées à utiliser le service de localisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zeigt den Netzwerknamen nur Apps mit Berechtigung für Ortungsdienste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS mostra il nome della rete solo alle app con il permesso di Localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは、位置情報サービスの許可があるAppにだけネットワーク名を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 위치 서비스 권한이 있는 앱에만 네트워크 이름을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS仅向拥有定位服务权限的App显示网络名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS只會向擁有定位服務權限的App顯示網路名稱。"
