    "Values from undocumented interfaces (SMC, HID). Min, max and average cover the last two minutes.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores de interfaces não documentadas (SMC, HID). Mín., máx. e média cobrem os últimos dois minutos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores de interfaces no documentadas (SMC, HID). Mínimo, máximo y media abarcan los dos últimos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs issues d’interfaces non documentées (SMC, HID). Min., max. et moyenne couvrent les deux dernières minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte aus nicht dokumentierten Schnittstellen (SMC, HID). Minimum, Maximum und Durchschnitt beziehen sich auf die letzten zwei Minuten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori da interfacce non documentate (SMC, HID). Minimo, massimo e media coprono gli ultimi due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書化されていないインターフェイス（SMC、HID）からの値です。最小・最大・平均は直近2分間のものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서화되지 않은 인터페이스(SMC, HID)의 값입니다. 최소, 최대, 평균은 최근 2분 기준입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值来自未公开的接口（SMC、HID）。最小值、最大值和平均值涵盖最近两分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值來自未公開的介面（SMC、HID）。最小值、最大值和平均值涵蓋最近兩分鐘。"
          }
        }
      }
    },
