    "Disk images and installer packages in Downloads and on the Desktop. Once an app is installed, its installer is no longer needed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens de disco e pacotes de instalação em Downloads e na Mesa. Depois que o app é instalado, o instalador não é mais necessário."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes de disco y paquetes de instalación en Descargas y en el escritorio. Una vez instalada la app, su instalador ya no hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images disque et paquets d’installation dans Téléchargements et sur le bureau. Une fois l’app installée, son programme d’installation n’est plus utile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Images und Installationspakete in „Downloads“ und auf dem Schreibtisch. Ist eine App installiert, wird ihr Installationsprogramm nicht mehr gebraucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini disco e pacchetti di installazione in Download e sulla scrivania. Una volta installata l’app, il programma di installazione non serve più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」とデスクトップにあるディスクイメージとインストーラパッケージです。アプリをインストールしたら、インストーラは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더와 데스크탑에 있는 디스크 이미지와 설치 패키지입니다. 앱을 설치한 후에는 설치 프로그램이 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下载”和桌面上的磁盘映像和安装器。App安装完成后就不再需要其安装器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載項目」和桌面上的磁碟映像檔和安裝器。App安裝完成後就不再需要其安裝器。"
          }
        }
      }
    },
