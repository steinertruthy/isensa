        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 빌드 때 Xcode가 다시 만듭니다. 처음에는 프로젝트 빌드가 더 오래 걸립니다."
          }
        },
        "zh-Hans": {
