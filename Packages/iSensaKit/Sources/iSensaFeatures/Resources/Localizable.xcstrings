    "Spotlight indexing, Time Machine and other system services run as other users, so their disk activity only shows in the totals above.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A indexação do Spotlight, o Time Machine e outros serviços do sistema rodam como outros usuários, por isso a atividade de disco deles só aparece nos totais acima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La indexación de Spotlight, Time Machine y otros servicios del sistema se ejecutan como otros usuarios, así que su actividad de disco solo aparece en los totales de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indexation Spotlight, Time Machine et d’autres services système s’exécutent sous d’autres utilisateurs : leur activité disque n’apparaît que dans les totaux ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Indizierung, Time Machine und andere Systemdienste laufen als andere Benutzer. Ihre Festplattenaktivität erscheint daher nur in den Summen oben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indicizzazione di Spotlight, Time Machine e altri servizi di sistema vengono eseguiti come altri utenti, quindi la loro attività del disco compare solo nei totali qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlightのインデックス作成、Time Machine、その他のシステムサービスは別のユーザとして動作するため、そのディスクアクティビティは上の合計にのみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 색인, Time Machine 및 기타 시스템 서비스는 다른 사용자로 실행되므로 해당 디스크 활동은 위의 합계에만 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聚焦索引、时间机器和其他系统服务以其他用户身份运行，因此它们的磁盘活动只体现在上方的总计中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight索引、Time Machine和其他系統服務以其他使用者身分執行，因此它們的磁碟活動只會顯示在上方的總計中。"
          }
        }
      }
    },
