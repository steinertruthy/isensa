          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten auf diesem Volume sind mit deinem Anmeldepasswort verschlüsselt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati su questo disco sono crittografati con la tua password di login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクのデータはログインパスワードで暗号化されています。"
