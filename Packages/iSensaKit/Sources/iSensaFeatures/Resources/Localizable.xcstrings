    "Recorded metrics and alerts are removed from this Mac. This cannot be undone.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As métricas e os alertas registrados serão removidos deste Mac. Esta ação não pode ser desfeita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las métricas y alertas registradas se eliminarán de este Mac. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures et alertes enregistrées seront supprimées de ce Mac. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgezeichnete Messwerte und Hinweise werden von diesem Mac entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le metriche e gli avvisi registrati verranno rimossi da questo Mac. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した測定値とアラートがこのMacから削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 측정값과 경고가 이 Mac에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的指标和警告将从这台Mac上移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
