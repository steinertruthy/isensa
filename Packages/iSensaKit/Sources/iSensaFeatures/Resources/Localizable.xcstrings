    "%@ system processes belong to other users and are not included.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ processos do sistema pertencem a outros usuários e não estão incluídos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ procesos del sistema pertenecen a otros usuarios y no se incluyen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ processus système appartiennent à d’autres utilisateurs et ne sont pas inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Systemprozesse gehören anderen Benutzern und sind nicht enthalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ processi di sistema appartengono ad altri utenti e non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@個のシステムプロセスはほかのユーザのもののため含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 프로세스 %@개는 다른 사용자의 것이므로 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有%@个系统进程属于其他用户，未包含在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有%@個系統程序屬於其他使用者，未包含在內。"
          }
        }
      }
    },
