---
import { translations, type Locale } from '../i18n';
import { repoLinks, repository } from '../lib/site';
import Icon from './Icon.astro';
import Link from './Link.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
const principles = Object.values(t.openSource.principles);
const links = [
  { href: repoLinks.issues, label: t.openSource.links.issues },
  { href: repoLinks.pulls, label: t.openSource.links.pulls },
  { href: repoLinks.releases, label: t.openSource.links.releases },
  { href: repoLinks.docs, label: t.openSource.links.docs },
  { href: repoLinks.contributing, label: t.openSource.links.contributing },
  { href: repoLinks.security, label: t.openSource.links.security },
  { href: repoLinks.license, label: t.openSource.links.license },
];
const stats = [
  { key: 'stars', label: t.openSource.stats.stars },
  { key: 'forks', label: t.openSource.stats.forks },
  { key: 'issues', label: t.openSource.stats.issues },
  { key: 'release', label: t.openSource.stats.release },
];
---
<section class="open section" id="open-source" aria-labelledby="open-title">
  <div class="wrap">
    <div class="section-head centered" data-reveal>
      <p class="eyebrow">{t.openSource.eyebrow}</p>
      <h2 class="section-title" id="open-title">{t.openSource.title}</h2>
      <p class="section-intro">{t.openSource.text}</p>
    </div>

    <dl class="principles" data-reveal>
      {principles.map((principle) => (
        <div>
          <dt>{principle.title}</dt>
          <dd>{principle.text}</dd>
        </div>
      ))}
    </dl>

    <div class="repo" data-reveal>
      <div class="repo-head">
        <Link class="button" href={repository.url}>
          <Icon name="github" />
          <span>{t.openSource.explore}</span>
        </Link>
        <p class="slug">github.com/{repository.owner}/{repository.name}</p>
      </div>
      <dl class="stats" data-repo-stats hidden>
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd data-stat={stat.key}>—</dd>
          </div>
        ))}
      </dl>
      <ul class="links">
        {links.map((link) => <li><Link href={link.href}>{link.label}<Icon name="external" /></Link></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .principles {
    display: grid;
    gap: 2rem;
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) 0 0;
  }
  .principles dt {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .principles dd {
    margin: 0.5rem 0 0;
    color: var(--text-2);
    max-width: 38ch;
  }
  .repo {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .repo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .slug {
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1.5rem;
    margin: 0;
  }
  .stats dt {
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .stats dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-number);
    font-variant-numeric: tabular-nums;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .links :global(a:hover) {
    color: var(--text);
  }
  .links :global(svg) {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }
  @media (min-width: 900px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>
