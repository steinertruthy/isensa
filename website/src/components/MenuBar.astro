---
import { Picture } from 'astro:assets';
import { translations, type Locale } from '../i18n';
import { screen } from '../lib/screens';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
const statusItem = screen('dark-statusitem');
const popover = screen('dark-popover');
---
<section class="menubar section" id="menu-bar" aria-labelledby="menubar-title">
  <div class="wrap layout">
    <div class="copy section-head" data-reveal>
      <p class="eyebrow">{t.menubar.eyebrow}</p>
      <h2 class="section-title" id="menubar-title">{t.menubar.title}</h2>
      <p class="section-intro">{t.menubar.text}</p>
      <ul class="points">
        {t.menubar.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
    <div class="composition" data-reveal style="--delay: 1">
      <div class="halo" aria-hidden="true"></div>
      <div class="item">
        <Picture src={statusItem} alt={t.menubar.statusAlt} formats={['avif']} fallbackFormat="webp" widths={[statusItem.width]} sizes={`${statusItem.width / 2}px`} loading="lazy" />
      </div>
      <div class="popover">
        <Picture src={popover} alt={t.menubar.popoverAlt} formats={['avif']} fallbackFormat="webp" widths={[308, 616]} sizes="(min-width: 640px) 308px, 80vw" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .menubar {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .layout {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }
  .points {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 46ch;
  }
  .points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-2);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
  }
  .composition {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    perspective: 1200px;
    transform-style: preserve-3d;
  }
  .composition > :not(.halo) {
    transform: rotateY(-14deg) rotateX(6deg);
    animation: bob 6s ease-in-out infinite alternate;
  }
  .composition > .item {
    transform: rotateY(-14deg) rotateX(6deg) translateZ(60px);
    animation-delay: 0.8s;
  }
  .halo {
    position: absolute;
    inset: 10% -10%;
    background:
      radial-gradient(closest-side at 30% 40%, color-mix(in srgb, var(--hue-cpu) 60%, transparent), transparent),
      radial-gradient(closest-side at 70% 60%, color-mix(in srgb, var(--hue-gpu) 55%, transparent), transparent),
      radial-gradient(closest-side at 50% 85%, color-mix(in srgb, var(--hue-thermal) 45%, transparent), transparent);
    opacity: var(--glow);
    filter: blur(50px);
  }
  @keyframes bob {
    to {
      translate: 0 -12px;
    }
  }
  .item {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line);
  }
  .item :global(img) {
    width: 110px;
    height: auto;
  }
  .popover {
    width: min(100%, 340px);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow), 0 0 0 1px var(--line);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
</style>
