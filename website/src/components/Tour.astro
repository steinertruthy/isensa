---
import { translations, type Locale } from '../i18n';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
---
<section class="tour stage section" id="tour" aria-labelledby="tour-title">
  <div class="wrap">
    <div class="intro">
      <h2 class="section-title" id="tour-title">{t.tour.title}</h2>
      <p class="section-intro">{t.tour.text}</p>
    </div>
    <figure class="player" data-tour>
      <video
        controls
        playsinline
        preload="none"
        poster={withBase('media/tour.webp')}
        width="1920"
        height="1080"
        aria-label={t.tour.label}
        data-tour-video
      >
        <source src={withBase('media/tour.mp4')} type="video/mp4" />
        <p>{t.tour.unsupported} <a href={withBase('media/tour.mp4')}>{t.tour.download}</a></p>
      </video>
      <button class="play" type="button" data-tour-play aria-label={t.tour.play}>
        <span class="disc"><Icon name="play" /></span>
        <span class="label">{t.tour.play}</span>
      </button>
    </figure>
  </div>
</section>

<style>
  .tour {
    background: var(--bg);
    color: var(--text);
  }
  .intro {
    display: grid;
    gap: 0;
  }
  .player {
    position: relative;
    margin: clamp(2.5rem, 2rem + 3vw, 4.5rem) 0 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: #0a0f1a;
    box-shadow: 0 0 0 1px var(--line), 0 40px 120px -40px rgb(46 155 255 / 0.25);
  }
  video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0a0f1a;
  }
  .play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    border: 0;
    background: linear-gradient(to top, rgb(10 15 26 / 0.55), rgb(10 15 26 / 0.1));
    color: #fff;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .play[hidden] {
    display: none;
  }
  .disc {
    display: grid;
    place-items: center;
    width: clamp(64px, 8vw, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.22) inset;
    transition: transform 0.45s var(--ease-spring), background-color 0.2s ease;
  }
  .disc :global(svg) {
    width: 38%;
    height: 38%;
    margin-left: 6%;
  }
  .play:hover .disc {
    transform: scale(1.07);
    background: rgb(255 255 255 / 0.2);
  }
  .label {
    font-weight: 600;
    font-size: var(--step-0);
  }
</style>
