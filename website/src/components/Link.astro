---
/**
 * Every link on the site goes through here: links that leave the website open in a new tab with
 * rel="noopener noreferrer"; links inside the site stay in the same tab.
 */
import type { HTMLAttributes } from 'astro/types';
import { externalAttributes, isExternal } from '../lib/links';

type Props = HTMLAttributes<'a'> & { href: string };
const { href, ...rest } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const external = isExternal(href, site.origin, import.meta.env.BASE_URL);
---
<a href={href} {...(external ? externalAttributes : {})} {...rest}><slot /></a>
