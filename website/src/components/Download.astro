---
import { localeInfo, translations, type Locale } from '../i18n';
import { repoLinks, repository } from '../lib/site';
import Icon from './Icon.astro';
import Link from './Link.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
// Strings the client script needs to describe the release it finds on GitHub.
const strings = {
  tag: localeInfo[locale].tag,
  version: t.download.version,
  stable: t.download.stable,
  beta: t.download.beta,
  loading: t.download.loading,
  buttonMac: t.download.buttonMac,
  buttonOther: t.download.buttonOther,
  noReleaseTitle: t.download.noReleaseTitle,
  noReleaseText: t.download.noReleaseText,
  errorText: t.download.errorText,
  notMac: t.download.notMac,
  archUnknown: t.download.archUnknown,
  allReleases: t.download.allReleases,
  copied: t.download.copied,
  copy: t.download.copy,
  architectures: { universal: 'Apple silicon + Intel (Universal)', arm64: 'Apple silicon (arm64)', x86_64: 'Intel (x86_64)' },
  latest: t.footer.latest,
  noRelease: t.footer.noRelease,
};
const requirements = Object.values(t.requirements.items);
---
<section class="download section" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <div class="section-head centered" data-reveal>
      <p class="eyebrow">{t.download.eyebrow}</p>
      <h2 class="section-title" id="download-title">{t.download.title}</h2>
      <p class="section-intro">{t.download.intro}</p>
    </div>

    <div class="panel" data-download data-state="idle" data-reveal data-spotlight>
      <script type="application/json" data-download-strings set:html={JSON.stringify(strings)} />
      <div class="identity">
        <Logo size={88} class="icon" />
        <div>
          <p class="name">iSensa</p>
          <p class="version" data-download-version>macOS</p>
          <span class="status" data-download-channel hidden></span>
        </div>
      </div>

      <div class="action">
        <Link class="button" href={repoLinks.releases} data-download-button>
          <Icon name="download" />
          <span data-download-label>{t.download.allReleases}</span>
        </Link>
        <p class="note" data-download-note aria-live="polite"></p>
      </div>

      <dl class="facts" data-download-facts hidden>
        <div><dt>{t.download.released}</dt><dd data-fact="released"></dd></div>
        <div><dt>{t.download.size}</dt><dd data-fact="size"></dd></div>
        <div><dt>{t.download.architecture}</dt><dd data-fact="architecture"></dd></div>
        <div class="checksum" data-fact-row="checksum" hidden>
          <dt>{t.download.checksum}</dt>
          <dd>
            <code data-fact="checksum"></code>
            <button type="button" class="copy" data-copy-checksum aria-label={t.download.copy}><Icon name="copy" /></button>
          </dd>
        </div>
      </dl>

      <ul class="links">
        <li data-notes-item hidden><Link href={repoLinks.releases} data-notes-link>{t.download.notes}</Link></li>
        <li><Link href={repoLinks.releases}>{t.download.allReleases}</Link></li>
        <li><Link href={repository.url}>{t.download.source}</Link></li>
        <li><Link href={repoLinks.license}>{t.download.license}</Link></li>
      </ul>
    </div>

    <div class="details">
      <div>
        <h3>{t.download.installTitle}</h3>
        <ol class="install">
          {t.download.install.map((step) => <li>{step}</li>)}
        </ol>
      </div>
      <div id="requirements">
        <h3>{t.requirements.title}</h3>
        <dl class="requirements">
          {requirements.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
        <p class="limitations">{t.requirements.limitations}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow), 0 0 0 1px var(--line);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  /* The icon's gauge sweeps up when the panel arrives. */
  .panel :global(.needle) {
    transition: stroke-dashoffset 1.8s 0.4s var(--ease-out);
  }
  :global(.js) .panel:not(.is-visible) :global(.needle) {
    stroke-dashoffset: 68;
  }
  .identity :global(.icon) {
    flex: none;
    filter: drop-shadow(0 10px 18px rgb(10 15 26 / 0.3));
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .version {
    margin-top: 0.25rem;
    color: var(--text-2);
    font-family: var(--font-number);
    font-variant-numeric: tabular-nums;
  }
  .identity .status {
    margin-top: 0.5rem;
  }
  .action {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
  }
  .note {
    color: var(--text-2);
    font-size: var(--step--1);
    max-width: 52ch;
  }
  .note:empty {
    display: none;
  }
  [data-state='loading'] .note {
    animation: breathe 1.6s ease-in-out infinite;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .facts dt,
  .requirements dt {
    color: var(--text-3);
    font-size: var(--step--1);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-number);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .checksum {
    grid-column: 1 / -1;
  }
  .checksum dd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .checksum code {
    overflow-wrap: anywhere;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text-2);
  }
  .copy {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--text) 7%, transparent);
    cursor: pointer;
  }
  .copy :global(svg) {
    width: 16px;
    height: 16px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }
  .links :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .links :global(a:hover) {
    text-decoration: underline;
  }
  .details {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .install {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .install li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    color: var(--text-2);
  }
  .install li::before {
    content: counter(step);
    font-family: var(--font-number);
    font-weight: 600;
    color: var(--text);
  }
  .requirements {
    display: grid;
    margin: 1.25rem 0 0;
  }
  .requirements div {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .requirements div:first-child {
    padding-top: 0;
  }
  .requirements dd {
    margin: 0;
  }
  .limitations {
    margin-top: 1.25rem;
    color: var(--text-3);
    font-size: var(--step--1);
  }
  @keyframes breathe {
    50% {
      opacity: 0.5;
    }
  }
  @media (min-width: 900px) {
    .panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
    .action {
      justify-items: end;
      text-align: right;
    }
    .facts,
    .links {
      grid-column: 1 / -1;
    }
    .details {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
    .requirements div {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
