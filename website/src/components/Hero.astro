---
import { translations, type Locale } from '../i18n';
import { withBase } from '../lib/paths';
import { repository } from '../lib/site';
import Icon from './Icon.astro';
import Link from './Link.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
const [lineOne, lineTwo] = t.hero.title.split('\n');
---
<section class="hero stage stage-top" aria-labelledby="hero-title">
  <div class="copy wrap">
    <h1 id="hero-title">
      <span>{lineOne}</span>
      {lineTwo && <span>{lineTwo}</span>}
    </h1>
    <p class="subtitle">{t.hero.subtitle}</p>
    <div class="actions">
      <a class="button" href="#download" data-download-primary>
        <Icon name="download" />
        <span>{t.hero.download}</span>
      </a>
      <Link class="button button-quiet" href={repository.url}>
        <Icon name="github" />
        <span>{t.hero.github}</span>
      </Link>
    </div>
    <p class="license">{t.hero.openSource}</p>
  </div>

  <div class="showcase wrap">
    <!-- The logo's gauge, drawn once behind the window as the page opens. -->
    <svg class="gauge" viewBox="0 0 1000 1000" aria-hidden="true">
      <defs>
        <linearGradient id="hero-gauge" x1="160" y1="820" x2="840" y2="220" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="var(--gauge-from)" />
          <stop offset="1" stop-color="var(--gauge-to)" />
        </linearGradient>
      </defs>
      <path class="track" d="M181.6 818.4A450 450 0 1 1 818.4 818.4" pathLength="100" />
      <path class="needle" d="M181.6 818.4A450 450 0 1 1 818.4 818.4" pathLength="100" stroke="url(#hero-gauge)" />
    </svg>
    <div class="window" data-parallax>
      <video
        class="video"
        muted
        loop
        playsinline
        preload="none"
        poster={withBase('media/hero.webp')}
        width="1600"
        height="1042"
        aria-label={t.hero.videoLabel}
        data-hero-video
      >
        <source src={withBase('media/hero.webm')} type="video/webm" />
        <source src={withBase('media/hero.mp4')} type="video/mp4" />
      </video>
      <button class="video-toggle" type="button" data-video-toggle data-play={t.hero.play} data-pause={t.hero.pause} aria-label={t.hero.play} hidden>
        <span class="when-playing"><Icon name="pause" /></span>
        <span class="when-paused"><Icon name="play" /></span>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -64px;
    padding-top: calc(64px + clamp(3.5rem, 2rem + 6vw, 8rem));
    background:
      radial-gradient(60% 50% at 50% 100%, rgb(46 155 255 / 0.1), transparent 70%),
      var(--bg);
    color: var(--text);
    overflow: hidden;
  }
  .copy {
    position: relative;
    z-index: 2;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  h1 span {
    display: block;
    animation: rise 1.1s var(--ease-out) both;
  }
  h1 span + span {
    animation-delay: 0.12s;
  }
  .subtitle {
    margin-top: 1.75rem;
    max-width: 44ch;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.5;
    animation: rise 1.1s 0.24s var(--ease-out) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: rise 1.1s 0.34s var(--ease-out) both;
  }
  .license {
    margin-top: 1.25rem;
    color: var(--text-3);
    font-size: var(--step--1);
    animation: rise 1.1s 0.42s var(--ease-out) both;
  }
  .showcase {
    position: relative;
    margin-top: clamp(3.5rem, 2rem + 6vw, 7rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .gauge {
    position: absolute;
    left: 50%;
    top: clamp(-9rem, -12vw, -3rem);
    width: min(118%, 1500px);
    max-width: none;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }
  .gauge path {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .gauge .track {
    stroke: var(--line);
  }
  .gauge .needle {
    stroke-width: 2;
    stroke-dasharray: 68 100;
    stroke-dashoffset: 68;
    animation: sweep 2.2s 0.5s var(--ease-out) forwards;
  }
  .window {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin-inline: auto;
    background: #1b2130;
    animation: lift 1.4s 0.3s var(--ease-out) both;
    will-change: transform;
  }
  .video {
    width: 100%;
    aspect-ratio: 1600 / 1042;
    object-fit: cover;
  }
  .video-toggle {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(10 15 26 / 0.62);
    color: #fff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-spring);
  }
  .video-toggle:hover,
  .video-toggle:focus-visible {
    opacity: 1;
    transform: scale(1.06);
  }
  .video-toggle :global(svg) {
    width: 16px;
    height: 16px;
  }
  .video-toggle .when-paused,
  .video-toggle[data-playing] .when-playing {
    display: inline-flex;
  }
  .video-toggle .when-playing,
  .video-toggle[data-playing] .when-paused {
    display: none;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(48px) scale(0.985);
    }
  }
  @keyframes sweep {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gauge .needle {
      stroke-dashoffset: 0;
    }
  }
</style>
