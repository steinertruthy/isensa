---
import { Picture } from 'astro:assets';
import { translations, type Locale } from '../i18n';
import { repository } from '../lib/site';
import { screen } from '../lib/screens';
import Icon from './Icon.astro';
import Link from './Link.astro';
import Screen from './Screen.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translations(locale);
const [lineOne, lineTwo] = t.hero.title.split('\n');
const popover = screen('dark-popover');
const statusItem = screen('dark-statusitem');
---
<section class="hero stage stage-top" aria-labelledby="hero-title">
  <!-- The app's component hues, as slow light behind the stage. -->
  <div class="aura" aria-hidden="true">
    <span style="--hue: var(--hue-cpu); --x: 18%; --y: 30%"></span>
    <span style="--hue: var(--hue-gpu); --x: 82%; --y: 26%"></span>
    <span style="--hue: var(--hue-memory); --x: 70%; --y: 78%"></span>
    <span style="--hue: var(--hue-thermal); --x: 26%; --y: 82%"></span>
  </div>
  <div class="floor" aria-hidden="true"></div>

  <div class="copy wrap">
    <p class="eyebrow hero-eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">
      <span class="line">{lineOne}</span>
      {lineTwo && <span class="line spectrum-text">{lineTwo}</span>}
    </h1>
    <p class="subtitle">{t.hero.subtitle}</p>
    <div class="actions">
      <a class="button" href="#download" data-download-primary>
        <Icon name="download" />
        <span>{t.hero.download}</span>
      </a>
      <a class="button button-quiet" href="#overview">
        <span>{t.hero.howItWorks}</span>
        <Icon name="arrow" />
      </a>
    </div>
    <ul class="meta">
      <li data-detected-os data-template={t.hero.detected} hidden></li>
      <li>{t.hero.platform}</li>
      <li><Link href={repository.url}>{t.hero.openSource}</Link></li>
    </ul>
  </div>

  <div class="stage3d wrap" data-hero-3d>
    <div class="scene">
      <div class="window main" data-zoom data-zoom-group="hero" data-zoom-caption={t.gallery.items.overview} aria-label={`${t.gallery.open}: ${t.gallery.items.overview}`}>
        <Screen name="overview" alt={t.hero.screenAlt} sizes="(min-width: 1200px) 1100px, 92vw" eager />
        <span class="glare" aria-hidden="true"></span>
      </div>
      <div class="float status-item">
        <Picture src={statusItem} alt={t.menubar.statusAlt} formats={['avif']} fallbackFormat="webp" widths={[statusItem.width]} sizes="110px" loading="eager" />
      </div>
      <div class="float popover" data-zoom data-zoom-group="hero" data-zoom-caption={t.gallery.items.popover} aria-label={`${t.gallery.open}: ${t.gallery.items.popover}`}>
        <Picture src={popover} alt={t.menubar.popoverAlt} formats={['avif']} fallbackFormat="webp" widths={[308, 616]} sizes="(min-width: 900px) 300px, 34vw" loading="eager" />
      </div>
      <!-- A little play: a pointer clicks the menu bar item and the popover pops open, on a loop. -->
      <span class="ring" aria-hidden="true"></span>
      <!-- The track covers the scene, so translate percentages are percentages of the window. -->
      <span class="cursor" aria-hidden="true">
        <svg viewBox="0 0 28 28">
          <path d="M6 3.5v19l5.2-5 3.4 7.6 3.3-1.5-3.3-7.4H21z" fill="#fff" stroke="#000" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -64px;
    padding-top: calc(64px + clamp(4rem, 2rem + 7vw, 8.5rem));
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
    isolation: isolate;
  }
  .aura {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  .aura span {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: min(60vw, 720px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--hue) 55%, transparent), transparent 62%);
    opacity: 0.22;
    filter: blur(40px);
    transform: translate(-50%, -50%);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .aura span:nth-child(2) {
    animation-duration: 22s;
    animation-direction: alternate-reverse;
  }
  .aura span:nth-child(3) {
    animation-duration: 26s;
    opacity: 0.14;
  }
  .aura span:nth-child(4) {
    animation-duration: 20s;
    animation-direction: alternate-reverse;
    opacity: 0.12;
  }
  @keyframes drift {
    to {
      transform: translate(-42%, -58%) scale(1.15);
    }
  }
  /* A receding floor grid, the ground the window stands on. */
  .floor {
    position: absolute;
    left: -25%;
    right: -25%;
    bottom: 0;
    height: 58%;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(700px) rotateX(62deg);
    transform-origin: bottom;
    mask-image: linear-gradient(to top, black 10%, transparent 85%);
    -webkit-mask-image: linear-gradient(to top, black 10%, transparent 85%);
  }
  .copy {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .hero-eyebrow {
    animation: rise 1s var(--ease-out) both;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .line {
    display: block;
    padding-bottom: 0.06em;
    animation: rise 1.1s var(--ease-out) both;
  }
  .line.spectrum-text {
    animation:
      rise 1.1s 0.1s var(--ease-out) both,
      spectrum 9s ease-in-out infinite alternate;
  }
  .subtitle {
    margin-top: 1.75rem;
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.5;
    animation: rise 1.1s 0.2s var(--ease-out) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: rise 1.1s 0.3s var(--ease-out) both;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-3);
    font-size: var(--step--1);
    animation: rise 1.1s 0.4s var(--ease-out) both;
  }
  .meta li {
    padding-inline: 1rem;
  }
  .meta li + li {
    border-left: 1px solid var(--line-strong);
  }
  .meta li[data-detected-os] {
    color: var(--text-2);
  }
  .meta :global(a) {
    text-decoration: none;
  }
  .meta :global(a:hover) {
    color: var(--text);
  }
  .stage3d {
    --tilt: 24;
    --rx: 0;
    --ry: 0;
    position: relative;
    margin-top: clamp(3.5rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(4rem, 3rem + 5vw, 8rem);
    perspective: 2200px;
    perspective-origin: 50% 0%;
    animation: arrive 1.6s 0.25s var(--ease-out) both;
  }
  .scene {
    position: relative;
    max-width: 1100px;
    margin-inline: auto;
    transform-style: preserve-3d;
    transform: rotateX(calc((var(--tilt) + var(--rx)) * 1deg)) rotateY(calc(var(--ry) * 1deg))
      scale(calc(1 - var(--tilt) * 0.003));
    transform-origin: 50% 100%;
    will-change: transform;
  }
  .main {
    cursor: zoom-in;
    transform: translateZ(0);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 60px 120px -40px rgb(0 0 0 / 0.9),
      0 0 140px -30px color-mix(in srgb, var(--hue-cpu) 45%, transparent);
  }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      60% 50% at calc(50% + var(--ry) * 8%) calc(20% - var(--rx) * 8%),
      rgb(255 255 255 / 0.1),
      transparent 70%
    );
    mix-blend-mode: screen;
  }
  .float {
    position: absolute;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.14),
      0 40px 80px -24px rgb(0 0 0 / 0.85);
  }
  .float :global(img) {
    width: 100%;
    height: auto;
  }
  .popover {
    cursor: zoom-in;
    right: -5%;
    top: 14%;
    width: 25%;
    border-radius: 18px;
    transform: translateZ(140px);
    animation:
      bob 7s ease-in-out infinite alternate,
      pop 10s 2s ease-in-out infinite;
  }
  .cursor {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    transform: translateZ(180px);
    pointer-events: none;
    animation: pointer 10s 2s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }
  .cursor svg {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.5));
    transform-origin: 6px 4px;
    animation: press 10s 2s ease-in-out infinite;
  }
  .ring {
    position: absolute;
    z-index: 2;
    left: calc(6% + 18px);
    top: calc(-4% - 6px);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--hue-cpu);
    box-shadow: 0 0 24px var(--hue-cpu);
    opacity: 0;
    transform: translateZ(170px);
    pointer-events: none;
    animation: ripple 10s 2s ease-out infinite;
  }
  @keyframes pointer {
    0% {
      translate: 46% 62%;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    30%,
    37% {
      translate: calc(6% + 30px) calc(-4% + 8px);
    }
    58%,
    74% {
      translate: 86% 44%;
      opacity: 1;
    }
    88%,
    100% {
      translate: 60% 78%;
      opacity: 0;
    }
  }
  @keyframes press {
    0%,
    31%,
    36%,
    100% {
      scale: 1;
    }
    33% {
      scale: 0.82;
    }
  }
  @keyframes ripple {
    0%,
    32% {
      opacity: 0;
      scale: 0.3;
    }
    34% {
      opacity: 1;
      scale: 0.5;
    }
    48%,
    100% {
      opacity: 0;
      scale: 2.6;
    }
  }
  @keyframes tap {
    0%,
    32%,
    42%,
    100% {
      filter: none;
      scale: 1;
    }
    34% {
      filter: brightness(1.5);
      scale: 0.94;
    }
  }
  @keyframes pop {
    0%,
    34%,
    100% {
      scale: 1;
    }
    37% {
      scale: 0.9;
    }
    43% {
      scale: 1.06;
    }
    49% {
      scale: 0.99;
    }
    54% {
      scale: 1;
    }
  }
  .status-item {
    animation:
      bob 6s 1s ease-in-out infinite alternate,
      tap 10s 2s ease-in-out infinite;
    left: 6%;
    top: -4%;
    width: 110px;
    border-radius: 8px;
    transform: translateZ(90px);
  }
  @keyframes bob {
    to {
      translate: 0 -10px;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(8px);
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(80px);
    }
  }
  @media (max-width: 760px) {
    .popover {
      right: -2%;
      top: 30%;
      width: 34%;
    }
    .status-item {
      width: 84px;
      left: 4%;
      top: -6%;
    }
    .meta li {
      padding-inline: 0.7rem;
    }
  }
  /* A sheen crosses the download button every few seconds. */
  .actions .button:not(.button-quiet)::after {
    animation: sheen 6s 2.5s ease-in-out infinite;
  }
  @keyframes sheen {
    0%,
    80% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }
  @media (hover: none) {
    .cursor,
    .ring {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage3d {
      --tilt: 0;
    }
    .cursor,
    .ring {
      display: none;
    }
  }
</style>
