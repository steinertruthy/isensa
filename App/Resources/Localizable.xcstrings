        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンヘルパーが時間内に応答しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬 도우미가 제때 응답하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风扇辅助程序未及时响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "風扇輔助程式未及時回應。"
          }
        }
      }
    },
    "This copy of iSensa is missing its fan helper or code signature.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do iSensa está sem o auxiliar das ventoinhas ou sem assinatura de código."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta copia de iSensa le falta el asistente de ventiladores o la firma de código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque à cette copie de iSensa son assistant des ventilateurs ou sa signature de code."
          }
