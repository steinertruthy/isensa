    "iSensa wants to install its fan helper.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iSensa quer instalar o auxiliar das ventoinhas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa quiere instalar su asistente de ventiladores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa souhaite installer son assistant des ventilateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa möchte sein Lüfter-Hilfsprogramm installieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa vuole installare l’helper delle ventole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensaがファンヘルパーをインストールしようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa가 팬 도우미를 설치하려고 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa 想要安装其风扇辅助程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iSensa 想要安裝其風扇輔助程式。"
          }
        }
      }
    },
    "iSensa wants to move “%@” to the Trash.": {
      "localizations": {
